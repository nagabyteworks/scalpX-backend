# ==============================================================================
# scalpX Backend .gitignore
# ==============================================================================

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# SQLite databases, WAL files & persistence artifacts
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db*

# Environment and secrets
.env
.env.*

# Logs
logs/
*.log

# Coverage & test reports
coverage/
.nyc_output/

# IDE & Editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.fleet/

# OS files
.DS_Store
Thumbs.db
