# Local backend listener. 127.0.0.1 supports Android Emulator's 10.0.2.2 host alias.
# Set HOST=0.0.0.0 only when testing from a phone on the trusted local Wi-Fi.
HOST=127.0.0.1
PORT=3000
BROKER_MODE=live
TRADING_ENABLED=false

# Backend-only Flattrade credentials. Set these in your untracked local .env file.
FLATTRADE_USER_ID=
FLATTRADE_API_KEY=
FLATTRADE_API_SECRET=
FLATTRADE_REDIRECT_URL=
FLATTRADE_ACCOUNT_ID=
FLATTRADE_WS_URL=

# Generate a local encryption key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_SESSION_ENCRYPTION_KEY=

MARKET_DATA_INITIAL_TICK_TIMEOUT_MS=5000
DB_PATH=./scalpx.db
