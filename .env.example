# scalpX Backend Environment Configuration

# Server
PORT=3000
HOST=0.0.0.0
BROKER_MODE=paper # "paper" or "live"
DB_PATH=./scalpx.db

# Authentication
APP_JWT_SECRET=super_secret_hs256_key_change_in_production

# Flattrade API v2 Credentials
FLATTRADE_API_KEY=your_flattrade_api_key
FLATTRADE_API_SECRET=your_flattrade_api_secret
FLATTRADE_USER_ID=your_flattrade_user_id
FLATTRADE_ACCOUNT_ID=your_flattrade_account_id
FLATTRADE_WS_URL=wss://piconnect.flattrade.in/PiConnectWSTp/

# Risk Management Limits
MAX_LOTS_PER_ORDER=4
DEFAULT_LOT_SIZE=25
MAX_OPEN_QTY_PER_SYMBOL=200
MAX_DAILY_LOSS_PAISE=500000 # 5,000 INR
