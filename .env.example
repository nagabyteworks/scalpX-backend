# ==============================================================================
# scalpX Backend Environment Configuration
# ==============================================================================
# Security Notice:
# On production EC2, this file MUST be stored at /etc/scalpx/env with
# permissions set to chmod 600, owned by root. NEVER commit actual credentials to Git.
# ==============================================================================

# Server Network Configuration
# IMPORTANT: Bind to 127.0.0.1 only — Caddy handles public HTTPS traffic
PORT=3000
HOST=127.0.0.1

# Production broker is Flattrade. No simulator mode is supported by the backend.
BROKER_MODE=live

# Trading Permission: independently controls whether new real orders can be submitted.
# MUST be explicitly set to 'true' to allow order placement.
# Emergency exits (exit-position, exit-all) are ALWAYS permitted regardless.
# Default: false (fail-closed). Never enable until all safety checks pass.
TRADING_ENABLED=false

# scalpX Android Client JWT Authentication Secret (min 8 chars; use 32+ in production)
APP_JWT_SECRET=super_secret_scalpx_jwt_key_min_32_chars_recommended

# Device administration and login secrets (backend only; generate independently).
DEVICE_ENROLLMENT_SECRET=<generate-a-random-secret-at-least-32-characters>
DEVICE_TOTP_SECRET=<backend-only-base32-totp-secret>

# ------------------------------------------------------------------------------
# Flattrade API v2 Credentials (Required for BROKER_MODE=live)
# ------------------------------------------------------------------------------
# Flattrade User ID / Client Code (e.g., FT012345)
FLATTRADE_USER_ID=MOCK_USER


# Flattrade API Key obtained from Flattrade Developer Portal
FLATTRADE_API_KEY=MOCK_KEY

# Flattrade API Secret obtained from Flattrade Developer Portal
FLATTRADE_API_SECRET=MOCK_SECRET

# Redirect URL registered in Flattrade Developer Portal
# Must point to the server's OAuth callback handler
FLATTRADE_REDIRECT_URL=https://trade.nagabyte.com/api/auth/flattrade/callback

# Optional Flattrade Account ID (defaults to FLATTRADE_USER_ID if omitted)
# FLATTRADE_ACCOUNT_ID=FT012345

# Flattrade WebSocket Feed URL (current Pi API v2 endpoint)
# FLATTRADE_WS_URL=wss://piconnect.flattrade.in/PiConnectWSAPI/



# ------------------------------------------------------------------------------
# Session Token Encryption (REQUIRED for BROKER_MODE=live)
# ------------------------------------------------------------------------------
# 32-byte AES-256-GCM key stored as 64 lowercase hex characters.
# Used to encrypt the daily Flattrade session token stored in SQLite.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit this value to Git. Store only in /etc/scalpx/env (chmod 600).
# DB_SESSION_ENCRYPTION_KEY=<64-hex-char-key-here>

# ------------------------------------------------------------------------------
# Persistence
# ------------------------------------------------------------------------------
# SQLite Database file path (WAL mode)
DB_PATH=/var/lib/scalpx/scalpx.db
